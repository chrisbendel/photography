# Copy to .env and fill in. Vite loads this into import.meta.env, which
# src/loaders/d1.ts reads at build time.

# Cloudflare account id — `yarn wrangler whoami`, or the dashboard sidebar.
CLOUDFLARE_ACCOUNT_ID=
# Printed by `yarn wrangler d1 create photography`; also in the D1 dashboard.
CLOUDFLARE_D1_DATABASE_ID=
# API token, Account » D1 » Read.
CLOUDFLARE_D1_TOKEN=

# R2 custom domain serving photo objects. MUST include the scheme, or every image
# URL comes out relative — the build rejects it outright.
PUBLIC_IMAGE_BASE=https://img.photos.cbendel.me
# Set to 0 to bypass Cloudflare Images and serve originals — the escape hatch if
# transformations aren't enabled on the zone.
PUBLIC_IMAGE_TRANSFORM=1

# Not here: CLOUDFLARE_AI_TOKEN, which is a Worker secret (`wrangler secret put`).
# Never add CLOUDFLARE_API_TOKEN — wrangler prefers it over your login session.
