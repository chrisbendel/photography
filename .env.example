# Copy to .env and fill in. Needed by the build (the D1 content loader reads the
# database over its REST API) and by the migration/backup scripts.

# Cloudflare account id — `wrangler whoami`, or the dashboard sidebar.
CF_ACCOUNT_ID=
# Printed by `wrangler d1 create photography`; also in the D1 dashboard.
CF_D1_DATABASE_ID=
# API token with D1:read (plus D1:write for the migration script).
CF_D1_TOKEN=

# R2 custom domain serving photo objects, no trailing slash.
PUBLIC_IMAGE_BASE=https://img.photos.cbendel.me
# Set to 0 to bypass Cloudflare Images and serve originals — the escape hatch if
# transformations aren't enabled on the zone.
PUBLIC_IMAGE_TRANSFORM=1
