---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
	title?: string;
	description?: string;
}

const { title = "Photography", description = "Selected film photography" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Chris Bendel — Photography"
			href="/rss.xml"
		/>
		<title>{title}</title>
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem("theme");
					if (saved === "light" || saved === "dark") {
						document.documentElement.setAttribute("data-theme", saved);
					}
				} catch (_) {}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Nav />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<script is:inline>
			(function () {
				var pull = document.getElementById("theme-pull");
				if (!pull) return;

				function currentTheme() {
					return document.documentElement.getAttribute("data-theme") || "light";
				}

				function syncTitle() {
					var theme = currentTheme();
					pull.title = theme === "dark" ? "Turn light on" : "Turn light off";
				}

				function flipTheme() {
					var next = currentTheme() === "dark" ? "light" : "dark";
					document.documentElement.setAttribute("data-theme", next);
					try {
						localStorage.setItem("theme", next);
					} catch (_) {}
					syncTitle();
				}

				syncTitle();

				pull.addEventListener("click", function () {
					pull.classList.add("is-pulling");
					// Trigger flip slightly into the pull, syncing the "click" feel
					setTimeout(flipTheme, 140);
					setTimeout(function () {
						pull.classList.remove("is-pulling");
					}, 600);
				});
			})();
		</script>
		<script is:inline>
			(function () {
				var input = document.getElementById("site-search");
				var clear = document.getElementById("search-clear");
				if (!input || !clear) return;

				// Lives here, not on the gallery page: the field is in the nav, so the
				// clear mark has to work on every page. The mosaic listens for `input`,
				// so dispatching one re-filters and resets ?q= on `/`; anywhere else
				// this just empties the field.
				clear.addEventListener("click", function () {
					input.value = "";
					input.dispatchEvent(new Event("input", { bubbles: true }));
					input.focus();
				});
			})();
		</script>
	</body>
</html>
