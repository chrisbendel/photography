---
const links = [
	{ href: "/series/", label: "Series" },
	{ href: "/about/", label: "About" },
	// No Feed link — /rss.xml is advertised via <link rel="alternate"> in Layout.
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site">
	<nav class="site-nav" aria-label="Primary">
		<a href="/" class="brand" aria-label="Gallery — every print">
			<svg
				class="brand-mark"
				viewBox="0 0 32 40"
				aria-hidden="true"
				focusable="false"
			>
				<defs>
					<clipPath id="brand-mark-clip">
						<path d="M 0 0 L 13 0 L 13 1 A 1 1 0 0 0 14 2 L 17 2 A 1 1 0 0 0 18 1 L 18 0 L 19 0 L 19 1 A 1 1 0 0 0 21 1 L 21 0 L 26 0 L 26 1 A 1 1 0 0 0 27 2 L 30 2 A 1 1 0 0 0 31 1 L 31 0 L 32 0 L 32 40 L 0 40 Z" />
					</clipPath>
				</defs>
				<path
					class="mark-sheet"
					d="M 0 0 L 13 0 L 13 1 A 1 1 0 0 0 14 2 L 17 2 A 1 1 0 0 0 18 1 L 18 0 L 19 0 L 19 1 A 1 1 0 0 0 21 1 L 21 0 L 26 0 L 26 1 A 1 1 0 0 0 27 2 L 30 2 A 1 1 0 0 0 31 1 L 31 0 L 32 0 L 32 40 L 0 40 Z"
				/>
				<g clip-path="url(#brand-mark-clip)">
					<circle class="mark-img" cx="9" cy="17" r="2.2" opacity="0.5" />
					<path
						class="mark-img"
						opacity="0.35"
						d="M 0 28 L 5 24 L 10 27 L 14 22 L 19 26 L 24 23 L 32 27 L 32 30 L 0 30 Z"
					/>
					<path
						class="mark-img"
						opacity="0.6"
						d="M 0 33 L 7 24 L 13 30 L 18 21 L 24 28 L 32 25 L 32 36 L 0 36 Z"
					/>
					<rect class="mark-img" x="0" y="36" width="32" height="4" opacity="0.4" />
				</g>
			</svg>
			<span class="brand-name">Gallery</span>
		</a>
		<ul>
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<form class="site-search" action="/" method="get" role="search">
			<label class="visually-hidden" for="site-search">Search photographs</label>
			<!-- A loupe — the tool you'd hold over a negative, and what the lightbox
			     is named for. Faint until the field has focus, like the rest of the
			     chrome. -->
			<svg class="loupe-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
				<circle cx="6.75" cy="6.75" r="4.25" fill="none" stroke="currentColor" stroke-width="1.1" />
				<line x1="10" y1="10" x2="14" y2="14" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
			</svg>
			<span class="field">
				<input
					type="search"
					id="site-search"
					name="q"
					placeholder="search"
					autocomplete="off"
					spellcheck="false"
					autocorrect="off"
					autocapitalize="off"
					enterkeyhint="search"
				/>
				<button type="button" class="search-clear" id="search-clear" aria-label="Clear search">
					<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
					</svg>
				</button>
			</span>
		</form>
		<button
			type="button"
			class="darkroom-pull"
			id="theme-pull"
			aria-label="Toggle darkroom light"
			title="Turn light on/off"
		>
			<svg viewBox="0 0 28 44" aria-hidden="true" focusable="false">
				<circle class="halo halo-outer" cx="14" cy="32" r="14" />
				<circle class="halo halo-inner" cx="14" cy="32" r="9" />
				<circle class="anchor" cx="14" cy="0.6" r="0.9" />
				<g class="cord-group">
					<line class="cord" x1="14" y1="0" x2="14" y2="20" />
					<circle class="knob" cx="14" cy="21" r="1.1" />
				</g>
				<g class="bulb-group">
					<rect class="cap" x="11.5" y="22.5" width="5" height="2.6" rx="0.4" />
					<ellipse class="glass" cx="14" cy="32" rx="5.8" ry="6.6" />
					<path
						class="filament"
						d="M 11 31 Q 12.5 33 14 31 Q 15.5 29 17 31 Q 15.5 33.5 14 32 Q 12.5 30.5 11 32 Z"
						fill="none"
					/>
					<ellipse class="highlight" cx="11.5" cy="29.5" rx="1.1" ry="1.8" />
				</g>
			</svg>
		</button>
	</nav>
</header>

<style>
	header.site {
		border-bottom: 1px solid var(--rule);
	}

	/* One row: the field shrinks to fit, so focusing it can't bump the cord to a second line. */
	nav.site-nav {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 1rem var(--gutter);
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		font-size: 0.85rem;
	}

	nav.site-nav .brand {
		text-decoration: none;
		color: var(--ink);
		font-weight: 500;
		letter-spacing: 0.02em;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}

	nav.site-nav .brand:hover {
		color: var(--ink);
	}

	.brand-mark {
		width: 1.4rem;
		height: 1.75rem;
		flex-shrink: 0;
		color: currentColor;
		display: block;
	}

	.brand-mark .mark-sheet {
		fill: currentColor;
	}

	.brand-mark .mark-img {
		fill: var(--paper);
	}

	.brand-name {
		display: inline-block;
	}

	@media (max-width: 480px) {
		.brand-name {
			display: none;
		}
	}

	form.site-search {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-left: auto;
		/* Load-bearing: an input's intrinsic min-width (~20ch) otherwise shoves the cord off-screen. */
		min-width: 0;
		color: var(--ink-faint);
		transition: color 0.2s ease;
	}

	form.site-search:focus-within {
		color: var(--ink);
	}

	.loupe-glyph {
		width: 0.8rem;
		height: 0.8rem;
		flex-shrink: 0;
		display: block;
	}

	/* Underline on the field, not the input, so the ✕ sits inside the rule. */
	.field {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		flex: 1 1 auto;
		min-width: 0;
		border-bottom: 1px solid var(--rule);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	/* Thickens like a nav underline, via shadow so nothing shifts by a pixel. */
	.field:focus-within {
		border-bottom-color: var(--ink);
		box-shadow: 0 1px 0 var(--ink);
	}

	/* Monospace, like the verso metadata — this is filing-cabinet language. */
	form.site-search input {
		font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--ink);
		background: none;
		border: 0;
		padding: 0.3rem 0 0.2rem;
		width: 6rem;
		flex: 1 1 auto;
		min-width: 0;
		transition: width 0.25s ease;
	}

	form.site-search input:focus {
		outline: none;
		width: 10rem;
	}

	form.site-search input::placeholder {
		color: var(--ink-faint);
		letter-spacing: 0.08em;
	}

	/* Ours replaces it — the native one is chrome from another site. */
	form.site-search input::-webkit-search-cancel-button {
		-webkit-appearance: none;
		appearance: none;
	}

	/* :placeholder-shown is the CSS read of "field is empty" — no script decides this. */
	.search-clear {
		display: none;
		background: none;
		border: 0;
		color: var(--ink-faint);
		cursor: pointer;
		/* Padding makes a thumb-sized hit box; negative margin keeps the mark and the
		   field where they were. None on the right, or the box hangs past the rule. */
		padding: 0.5rem 0.3rem;
		margin: -0.5rem 0 -0.5rem -0.3rem;
		flex-shrink: 0;
	}

	form.site-search:has(input:not(:placeholder-shown)) .search-clear {
		display: flex;
		align-items: center;
	}

	.search-clear:hover {
		color: var(--ink);
	}

	.search-clear svg {
		width: 0.8rem;
		height: 0.8rem;
		display: block;
	}

	/* No submit button: `/` filters as you type, and elsewhere the keyboard's own
	   return/search key submits (see `enterkeyhint`). */

	/* Too narrow for links, field and cord: the field takes its own row, after the
	   cord so the cord still hangs from the top edge. px not rem — MQs ignore the
	   18px root. */
	@media (max-width: 544px) {
		nav.site-nav {
			flex-wrap: wrap;
		}

		form.site-search {
			order: 1;
			flex-basis: 100%;
			margin-left: 0;
		}

		form.site-search input,
		form.site-search input:focus {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		form.site-search,
		form.site-search input,
		.field {
			transition: none;
		}
	}

	/* The links take the slack, so the cord stays hard right. */
	nav.site-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 1.25rem;
		flex: 1;
	}

	/* Undecorated by default (chrome convention); underline on hover/focus. */
	nav.site-nav ul a {
		text-decoration: none;
		color: var(--ink-soft);
		letter-spacing: 0.06em;
		text-transform: lowercase;
		padding: 0.4rem 0;
	}

	nav.site-nav ul a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.25em;
	}

	nav.site-nav ul a[aria-current="page"] {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.25em;
	}

	/* ---------- Darkroom pull-cord light switch ---------- */

	button.darkroom-pull {
		background: none;
		border: 0;
		padding: 0;
		margin-left: 1.25rem;
		cursor: pointer;
		color: var(--ink);
		display: inline-flex;
		align-items: flex-start;
		height: 2.6rem;
		overflow: visible;
	}

	button.darkroom-pull svg {
		width: 1.45rem;
		height: 2.55rem;
		overflow: visible;
	}

	/* Idle (off) state */
	.anchor {
		fill: var(--ink-faint);
	}

	.cord {
		stroke: var(--ink-faint);
		stroke-width: 0.6;
		stroke-linecap: round;
		transform-origin: 14px 0;
		transition: stroke 0.25s ease;
	}

	.knob {
		fill: var(--ink);
		stroke: none;
		transition: transform 0.15s ease;
	}

	.cap {
		fill: var(--ink-faint);
		transition: fill 0.3s ease;
	}

	.glass {
		fill: color-mix(in srgb, var(--ink) 8%, transparent);
		stroke: var(--ink-soft);
		stroke-width: 0.8;
		transition: fill 0.4s ease, stroke 0.3s ease;
	}

	.filament {
		stroke: var(--ink-faint);
		stroke-width: 0.55;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.45;
		transition: stroke 0.3s ease, opacity 0.3s ease, stroke-width 0.3s ease;
	}

	.highlight {
		fill: #fff;
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.halo {
		opacity: 0;
		transition: opacity 0.4s ease, r 0.4s ease;
		pointer-events: none;
	}

	.halo-inner {
		fill: #ffe88a;
		filter: blur(1.5px);
	}

	.halo-outer {
		fill: #fff2b8;
		filter: blur(5px);
	}

	/* On (lit) — the default state, since the site is light unless told otherwise. */
	:global(:root:not([data-theme="dark"])) .glass {
		fill: #fff1b8;
		stroke: #d4a82b;
	}
	:global(:root:not([data-theme="dark"])) .cap {
		fill: var(--ink-soft);
	}
	:global(:root:not([data-theme="dark"])) .filament {
		stroke: #d68500;
		stroke-width: 0.85;
		opacity: 1;
	}
	:global(:root:not([data-theme="dark"])) .highlight {
		opacity: 0.85;
	}
	:global(:root:not([data-theme="dark"])) .halo-inner {
		opacity: 0.75;
	}
	:global(:root:not([data-theme="dark"])) .halo-outer {
		opacity: 0.45;
	}

	/* Off in dark mode. */
	:global(:root[data-theme="dark"]) .halo {
		opacity: 0;
	}
	:global(:root[data-theme="dark"]) .highlight {
		opacity: 0;
	}

	/* Pull animation */
	@keyframes cord-stretch {
		0%   { transform: scaleY(1); }
		22%  { transform: scaleY(1.20); }
		55%  { transform: scaleY(0.93); }
		80%  { transform: scaleY(1.05); }
		100% { transform: scaleY(1); }
	}

	@keyframes bulb-tug {
		0%   { transform: translateY(0); }
		22%  { transform: translateY(3.5px); }
		55%  { transform: translateY(-1.6px); }
		80%  { transform: translateY(0.9px); }
		100% { transform: translateY(0); }
	}

	@keyframes halo-flash {
		0%   { transform: scale(1); }
		30%  { transform: scale(1.15); }
		100% { transform: scale(1); }
	}

	button.darkroom-pull.is-pulling .cord-group {
		animation: cord-stretch 0.55s cubic-bezier(0.5, 0, 0.4, 1.6);
		transform-origin: top;
	}

	button.darkroom-pull.is-pulling .bulb-group {
		animation: bulb-tug 0.55s cubic-bezier(0.5, 0, 0.4, 1.6);
	}

	button.darkroom-pull.is-pulling .halo {
		animation: halo-flash 0.55s ease;
		transform-origin: 14px 32px;
	}

	button.darkroom-pull:hover .cord {
		stroke: var(--ink);
	}

	button.darkroom-pull:hover .knob {
		transform: translateY(0.6px);
	}

	/* Inherits global :focus-visible ring. */

	@media (prefers-reduced-motion: reduce) {
		button.darkroom-pull.is-pulling .cord-group,
		button.darkroom-pull.is-pulling .bulb-group,
		button.darkroom-pull.is-pulling .halo {
			animation: none;
		}
	}
</style>
