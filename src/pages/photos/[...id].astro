---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatLabel } from "../../lib/format";
import { titleFromSlug } from "../../lib/series";

export async function getStaticPaths() {
	const photos = await getCollection("photos");
	return photos.map((photo) => ({
		params: { id: photo.id },
		props: { photo },
	}));
}

const { photo } = Astro.props;
const { year, image, alt, caption, lens, film, location, format, series, tags, notes } =
	photo.data;
const seriesLabel = series ? titleFromSlug(series) : null;
---

<Layout title={`#${photo.id} — Chris Bendel`} description={alt}>
	<figure class="print-figure" data-invert="false">
		<div class="print-frame">
			<Image src={image} alt={alt} loading="eager" fetchpriority="high" class="print-img" />
			<button
				type="button"
				class="invert-btn"
				aria-pressed="false"
				aria-label="Toggle negative"
				title="View as negative"
			>
				<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
					<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
					<path d="M 12 3 A 9 9 0 0 1 12 21 Z" fill="currentColor" />
				</svg>
			</button>
		</div>
		{caption && <figcaption>{caption}</figcaption>}
	</figure>

	<script is:inline>
		(function () {
			const figs = document.querySelectorAll(".print-figure");
			figs.forEach((fig) => {
				const btn = fig.querySelector(".invert-btn");
				if (!btn) return;
				btn.addEventListener("click", () => {
					const inverted = fig.getAttribute("data-invert") === "true";
					const next = !inverted;
					fig.setAttribute("data-invert", String(next));
					btn.setAttribute("aria-pressed", String(next));
					btn.setAttribute(
						"title",
						next ? "View as positive" : "View as negative",
					);
				});
			});
		})();
	</script>

	<dl class="photo-meta">
		{year && (<><dt>Year</dt><dd>{year}</dd></>)}
		{location && (<><dt>Location</dt><dd>{location}</dd></>)}
		{lens && (<><dt>Lens</dt><dd>{lens}</dd></>)}
		{film && (<><dt>Film</dt><dd>{film}</dd></>)}
		{format && (<><dt>Format</dt><dd>{formatLabel(format)}</dd></>)}
		{series && seriesLabel && (
			<>
				<dt>Series</dt>
				<dd><a href={`/series/${series}/`}>{seriesLabel}</a></dd>
			</>
		)}
	</dl>

	{notes?.trim() && (
		<section class="notes">
			<h2>Notes</h2>
			<p>{notes.trim()}</p>
		</section>
	)}

	{
		tags && tags.length > 0 && (
			<p class="photo-tags">
				{tags.map((t, i) => (
					<>
						{i > 0 && ", "}
						<a href={`/?q=${encodeURIComponent(t)}`}>{t}</a>
					</>
				))}
			</p>
		)
	}
</Layout>

<style>
	.print-figure {
		margin: 0;
	}

	.print-frame {
		position: relative;
		display: block;
		line-height: 0;
	}

	.print-img {
		display: block;
		width: 100%;
		height: auto;
		transition: filter 0.35s ease;
	}

	.print-figure[data-invert="true"] .print-img {
		filter: invert(1);
	}

	.invert-btn {
		position: absolute;
		bottom: 0.6rem;
		right: 0.6rem;
		width: 2rem;
		height: 2rem;
		padding: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: rgba(20, 17, 14, 0.55);
		color: #f3efe6;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 999px;
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
		backdrop-filter: blur(4px);
	}

	.invert-btn:hover {
		background: rgba(20, 17, 14, 0.82);
		border-color: rgba(255, 255, 255, 0.4);
	}

	.invert-btn:focus-visible {
		outline: 2px solid #f3efe6;
		outline-offset: 2px;
	}

	.print-figure[data-invert="true"] .invert-btn {
		transform: rotate(180deg);
	}

	dl.photo-meta {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.3rem 1.25rem;
		color: var(--ink-soft);
		font-size: 0.8rem;
		margin: 0;
		font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
		letter-spacing: 0.04em;
	}

	dl.photo-meta dt {
		color: var(--ink-faint);
		text-transform: uppercase;
		font-size: 0.7rem;
		padding-top: 0.1rem;
	}

	dl.photo-meta dd {
		margin: 0;
	}

	dl.photo-meta dd a {
		color: var(--ink);
	}

	/* Running prose wants a shorter line than the page measure. */
	section.notes {
		max-width: 34rem;
	}

	/* Plain text, so line and paragraph breaks are the only structure there is. */
	section.notes p {
		white-space: pre-wrap;
		margin: 0;
	}

	section.notes h2 {
		font-size: 1rem;
		margin: 0 0 0.4rem;
	}

	/* A footer thought, so a little clear of the metadata above it. */
	.photo-tags {
		margin: 0.5rem 0 0;
		color: var(--ink-faint);
		font-size: 0.85rem;
	}

	.photo-tags a {
		color: var(--ink);
	}
</style>
