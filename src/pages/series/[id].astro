---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { getSeries } from "../../lib/series";

export async function getStaticPaths() {
	return (await getSeries()).map((series) => ({
		params: { id: series.slug },
		props: { series },
	}));
}

const { series } = Astro.props;
const { photos } = series;
---

<Layout title={`${series.title} — Chris Bendel`}>
	<h1>{series.title}</h1>

	<div class="print-stack">
		{
			photos.map((photo) => (
				<a class="print-entry" href={`/photos/${photo.id}/`} id={photo.id}>
					<div class="print-mount">
						<figure>
							<Image src={photo.data.image} alt={photo.data.alt} loading="lazy" />
							{photo.data.caption && <figcaption>{photo.data.caption}</figcaption>}
						</figure>
					</div>
				</a>
			))
		}
	</div>

</Layout>

<style>
	.print-stack {
		display: flex;
		flex-direction: column;
		gap: var(--gap);
	}

	.print-entry {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.print-mount figure {
		margin: 0;
	}

	.print-mount img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Caption sits flush under image (small gap), reads as one unit. */
	.print-mount figcaption {
		margin: 0.2rem 0 0;
		color: var(--ink-faint);
		font-size: 0.8rem;
		font-style: italic;
	}

	@media (prefers-reduced-motion: reduce) {
		.print-mount {
			transition: none;
			transform: none !important;
		}
	}
</style>
