---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — Chris Bendel" description="About Chris Bendel and this collection.">
	<section class="about">
		<h1>Chris Bendel</h1>

		<p class="lede">
			One or two sentences on who you are and what you photograph.
		</p>

		<p>
			Longer paragraph if you want one — where you shoot, what draws you to a
			frame, how long you've been at it. Or delete this and let the first line
			stand on its own.
		</p>

		<h2>Process</h2>
		<p>
			Cameras, film stocks, how you scan and print. Optional — remove the
			heading if it isn't interesting to write.
		</p>

		<h2>Contact</h2>
		<dl class="contact">
			<dt>Email</dt>
			<dd><a href="mailto:you@example.com">you@example.com</a></dd>
			<dt>Elsewhere</dt>
			<dd><a href="https://example.com" rel="me">example.com</a></dd>
		</dl>

		<p class="colophon">
			Prints are scanned at home and posted here as they're made. The feed is at
			<a href="/rss.xml">/rss.xml</a>.
		</p>
	</section>
</Layout>

<style>
	/* Prose wants a shorter line than the page measure. */
	.about {
		max-width: 34rem;
	}

	.lede {
		font-size: 1.1rem;
	}

	h2 {
		margin-top: 2rem;
	}

	dl.contact {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.3rem 1.25rem;
		margin: 0 0 1rem;
		font-size: 0.85rem;
	}

	dl.contact dt {
		color: var(--ink-faint);
		text-transform: uppercase;
		font-size: 0.7rem;
		padding-top: 0.15rem;
		font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
		letter-spacing: 0.04em;
	}

	dl.contact dd {
		margin: 0;
	}

	.colophon {
		margin-top: 2.5rem;
		color: var(--ink-soft);
		font-size: 0.85rem;
	}
</style>
