---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { allTags, getPhoto, getTags, isPhotoId, listSeries, studioPreview } from "../../lib/studio";

export const prerender = false;

const { id } = Astro.params;
const db = env.DB;

if (!id || !isPhotoId(id)) return Astro.redirect("/studio/");
const photo = await getPhoto(db, id);
if (!photo) return Astro.redirect("/studio/");

const [tags, series, tagVocabulary] = await Promise.all([
	getTags(db, id),
	listSeries(db),
	allTags(db),
]);

const saved = Astro.url.searchParams.has("saved");
const publishState =
	Astro.url.searchParams.get("published") ?? Astro.url.searchParams.get("unpublished");
const isPublished = photo.published === 1;
---

<Layout title={`${id} — Studio`} description="Edit photograph.">
	<p class="crumb"><a href="/studio/">← Studio</a></p>

	{saved && <p class="note">Saved.</p>}
	{
		publishState === "building" && (
			<p class="note">Saved — rebuild triggered, live in a minute or two.</p>
		)
	}
	{
		publishState === "pending" && (
			<p class="note">
				Flag updated, but no deploy hook is configured — the public site won't change
				until a build runs.
			</p>
		)
	}

	<div class="edit">
		<img src={studioPreview(photo.image_key)} alt={photo.alt} />

		<form method="POST" action="/studio/api/save" class="fields">
			<input type="hidden" name="id" value={id} />

			<p class="state">
				<code>{id}</code>
				<span>{isPublished ? "published" : "draft"}</span>
				<span>added {photo.added}</span>
			</p>

			<label>
				Alt text <span class="req">required</span>
				<textarea name="alt" rows="2" required>{photo.alt}</textarea>
			</label>

			<label>
				Caption
				<input name="caption" value={photo.caption ?? ""} />
			</label>

			<div class="pair">
				<label>
					Date made
					<input name="date" type="date" value={photo.date ?? ""} />
				</label>
				<label>
					Format
					<input name="format" value={photo.format ?? ""} placeholder="4x5" />
				</label>
			</div>

			<div class="pair">
				<label>
					Camera
					<input name="camera" value={photo.camera ?? ""} />
				</label>
				<label>
					Film
					<input name="film" value={photo.film ?? ""} />
				</label>
			</div>

			<label>
				Location
				<input name="location" value={photo.location ?? ""} />
			</label>

			<label>
				Series
				<input
					name="series"
					list="series-list"
					value={photo.series ?? ""}
					placeholder="pick one, or type a new slug"
				/>
				<span class="hint">A name with no series yet creates one.</span>
			</label>
			<datalist id="series-list">
				{series.map((s) => <option value={s.slug}>{s.title}</option>)}
			</datalist>

			<label>
				Tags
				<input
					name="tags"
					id="tags"
					value={tags.join(", ")}
					list="tag-list"
					placeholder="comma separated"
				/>
			</label>
			<datalist id="tag-list">
				{tagVocabulary.map((t) => <option value={t} />)}
			</datalist>

			<div class="suggest">
				<button type="button" id="suggest-btn" data-id={id}>Suggest caption & tags</button>
				<span id="suggest-status" aria-live="polite"></span>
			</div>
			<div id="suggest-out" hidden>
				<p class="hint">Suggestions — click a tag to add it.</p>
				<p id="suggest-caption" class="suggest-caption"></p>
				<p id="suggest-tags" class="suggest-tags"></p>
			</div>

			<label>
				Notes <span class="hint">markdown</span>
				<textarea name="notes" rows="8">{photo.notes ?? ""}</textarea>
			</label>

			<button type="submit" class="primary">Save</button>
		</form>
	</div>

	<div class="danger">
		<form method="POST" action={`/studio/api/${isPublished ? "unpublish" : "publish"}`}>
			<input type="hidden" name="id" value={id} />
			<button type="submit">{isPublished ? "Unpublish" : "Publish"}</button>
			<span class="hint">
				{isPublished
					? "Removes it from the live site on the next build."
					: "Needs alt text. Triggers a rebuild."}
			</span>
		</form>

		<form method="POST" action="/studio/api/delete" data-confirm="Delete this photograph and its image? This cannot be undone.">
			<input type="hidden" name="id" value={id} />
			<button type="submit" class="destructive">Delete</button>
			<span class="hint">Removes the row and the R2 object.</span>
		</form>
	</div>
</Layout>

<script is:inline>
	(function () {
		const btn = document.getElementById("suggest-btn");
		const status = document.getElementById("suggest-status");
		const out = document.getElementById("suggest-out");
		const capEl = document.getElementById("suggest-caption");
		const tagsEl = document.getElementById("suggest-tags");
		const tagsInput = document.getElementById("tags");

		if (btn && status && out && capEl && tagsEl && tagsInput) {
			btn.addEventListener("click", async () => {
				btn.disabled = true;
				status.textContent = "Looking…";
				try {
					const body = new FormData();
					body.set("id", btn.dataset.id);
					const res = await fetch("/studio/api/suggest", { method: "POST", body });
					if (!res.ok) throw new Error(await res.text());
					const data = await res.json();

					capEl.textContent = data.caption || "(no caption returned)";
					tagsEl.replaceChildren();
					(data.tags || []).forEach((tag) => {
						const chip = document.createElement("button");
						chip.type = "button";
						chip.className = "chip";
						chip.textContent = tag;
						chip.addEventListener("click", () => {
							const current = tagsInput.value
								.split(",")
								.map((t) => t.trim())
								.filter(Boolean);
							if (!current.includes(tag)) current.push(tag);
							tagsInput.value = current.join(", ");
							chip.disabled = true;
						});
						tagsEl.append(chip);
					});

					out.hidden = false;
					status.textContent = "";
				} catch (err) {
					status.textContent = "Failed: " + (err.message || err);
				} finally {
					btn.disabled = false;
				}
			});
		}

		// Deleting removes the R2 object too, so confirm before submitting.
		document.querySelectorAll("form[data-confirm]").forEach((form) => {
			form.addEventListener("submit", (e) => {
				if (!confirm(form.dataset.confirm)) e.preventDefault();
			});
		});
	})();
</script>

<style>
	.crumb {
		font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.note {
		border-left: 2px solid var(--ink-faint);
		padding-left: 0.75rem;
		color: var(--ink-soft);
		font-size: 0.9rem;
	}

	.edit > img {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 1.5rem;
	}

	.fields {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.state {
		display: flex;
		gap: 1rem;
		margin: 0;
		font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-faint);
	}

	label {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.9rem;
	}

	.req,
	.hint {
		color: var(--ink-faint);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	input,
	textarea {
		font: inherit;
		background: transparent;
		border: 1px solid var(--rule);
		color: var(--ink);
		padding: 0.4rem 0.5rem;
		width: 100%;
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--ink);
	}

	textarea {
		resize: vertical;
	}

	.pair {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.pair label {
		flex: 1;
		min-width: 8rem;
	}

	button {
		font: inherit;
		background: transparent;
		border: 1px solid var(--rule);
		color: var(--ink);
		padding: 0.4rem 0.9rem;
		cursor: pointer;
	}

	button:hover:not(:disabled) {
		border-color: var(--ink);
	}

	button:disabled {
		color: var(--ink-faint);
		cursor: default;
	}

	button.primary {
		border-color: var(--ink);
		align-self: flex-start;
	}

	.suggest {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.suggest-caption {
		font-style: italic;
		margin: 0.25rem 0;
	}

	.suggest-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.25rem 0;
	}

	button.chip {
		font-size: 0.78rem;
		padding: 0.15rem 0.5rem;
	}

	.danger {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.danger form {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	button.destructive:hover {
		border-color: var(--ink);
		background: color-mix(in srgb, var(--ink) 8%, transparent);
	}
</style>
