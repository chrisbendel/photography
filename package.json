{
  "name": "photography",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "yarn run build && wrangler dev",
    "dev:worker": "yarn run build && wrangler dev --var STUDIO_DEV_BYPASS:1",
    "astro": "astro",
    "migrate-to-d1": "node --env-file-if-exists=.env scripts/migrate-to-d1.mjs",
    "export-to-git": "node --env-file-if-exists=.env scripts/export-to-git.mjs",
    "d1:migrate": "wrangler d1 migrations apply photography --remote",
    "d1:migrate:local": "wrangler d1 migrations apply photography --local",
    "generate-types": "wrangler types",
    "deploy": "yarn run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.3.1",
    "@astrojs/rss": "^4.0.18",
    "astro": "^6.1.10",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "wrangler": "^4.87.0"
  },
  "packageManager": "yarn@4.9.1",
  "overrides": {
    "vite": "^7"
  }
}
