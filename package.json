{
  "name": "photography",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "yarn run build && wrangler dev",
    "dev:local": "yarn run d1:migrate:local && LOCAL_D1=1 PUBLIC_IMAGE_LOCAL=1 astro build && wrangler dev --var STUDIO_DEV_BYPASS:1",
    "astro": "astro",
    "d1:migrate": "wrangler d1 migrations apply photography --remote",
    "d1:migrate:local": "wrangler d1 migrations apply photography --local",
    "generate-types": "wrangler types",
    "deploy": "yarn run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.3.1",
    "@astrojs/rss": "^4.0.18",
    "astro": "^6.1.10"
  },
  "devDependencies": {
    "wrangler": "^4.87.0"
  },
  "packageManager": "yarn@4.9.1",
  "overrides": {
    "vite": "^7"
  }
}
