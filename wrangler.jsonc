{
	"compatibility_date": "2026-05-04",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "photography",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Per-PR preview URLs. Workers Builds runs `versions upload` on non-production
	// branches, and each uploaded version gets a URL under workers.dev — which is
	// also why workers.dev itself has to be on: previews can't live anywhere else.
	// Both are set explicitly rather than left to default, since preview_urls
	// otherwise just inherits whatever workers_dev happens to be.
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}