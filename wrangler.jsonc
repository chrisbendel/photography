{
	"compatibility_date": "2026-05-04",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "photography",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Per-PR previews live under workers.dev, so both must be set explicitly.
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}