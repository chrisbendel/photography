{
	"compatibility_date": "2026-05-04",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "photography",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Per-PR preview URLs live under workers.dev, so workers_dev has to stay on.
	// Both set explicitly — preview_urls otherwise just inherits workers_dev.
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}